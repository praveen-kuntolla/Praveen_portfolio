# Browser-safe Supabase connection (Project Settings / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Server-only. Required for administrator invitations and the bootstrap command.
# Use the Supabase secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Public deployed origin; used to build password-reset and invitation callbacks.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
